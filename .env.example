# Copy to .env and fill in real values.

# Static bearer token the browser extension and other clients must send. Required.
API_TOKEN=change-me

# --- OpenSearch (local Docker cluster from docker-compose.yml, no auth) ---
OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# --- LLM: any OpenAI-compatible endpoint ---
LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Embeddings: may be a different endpoint than the chat model ---
# EMBEDDING_API_KEY=            # defaults to LLM_API_KEY
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# Folder for OpenSearch snapshots (docker-compose.yml). Default: ./backups
# KB_BACKUP_DIR=/mnt/c/Users/<you>/kb-backups
